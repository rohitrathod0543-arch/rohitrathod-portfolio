# ========================================================================
# ROHIT RATHOD PORTFOLIO - ENVIRONMENT CONFIGURATION
# ========================================================================
# Create a .env file locally with your actual Supabase credentials.
# Get these from your Supabase Dashboard: Project Settings -> API.
#
# NOTE: VITE_SUPABASE_ANON_KEY is the public "anon" key, safe for browser use.
# NEVER put your "service_role" secret key here!

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Vite base path (defaults to /rohitrathodportfolio/ in production build, or / in local dev)
# VITE_BASE_PATH="/rohitrathodportfolio/"
